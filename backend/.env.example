PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/padhai

# ===================================================
# AI Provider Configuration
# ===================================================
# "ollama"  → use local Ollama (FREE, private, no API key needed) — auto falls back to Gemini if Ollama is down
# "gemini"  → use Google Gemini only (requires GEMINI_API_KEY below)
# "auto"    → same as "ollama"
AI_PROVIDER=ollama

# Local Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Google Gemini API Key (optional — used as fallback when Ollama is down)
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube Data API v3 Key
YOUTUBE_API_KEY=your_youtube_api_key_here

# JWT Secret for Session & Auth
JWT_SECRET=your_jwt_secret_here

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
